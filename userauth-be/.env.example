# Application: e.g. false and development. Never enable DEBUG in production.
DEBUG=
ENVIRONMENT=

# PostgreSQL async URL, e.g. postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
ASYNC_DATABASE_URL=
# Connection pool: e.g. 5, 10, 30 seconds and 1800 seconds respectively.
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
DATABASE_POOL_TIMEOUT=
DATABASE_POOL_RECYCLE=

# Two distinct secrets (generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET_KEY=
JWT_REFRESH_TOKEN_SECRET=
# Algorithm: e.g. HS256.
JWT_ALGORITHM=
# Lifetime format is days,hours,minutes,seconds. Assessment values: 0,0,15,0 and 7,0,0,0.
JWT_ACCESS_TOKEN_LIFETIME=
JWT_REFRESH_TOKEN_LIFETIME=

# Explicit comma-separated browser origins, e.g. frontend http://localhost:3000 and direct Swagger http://127.0.0.1:8000.
# No wildcard for credentialed cookies.
CORS_ALLOWED_ORIGINS=
# Comma-separated methods and headers, e.g. GET,POST and Content-Type,Authorization.
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=
# false for local HTTP; true for HTTPS.
COOKIE_SECURE=
